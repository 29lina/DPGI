<Window x:Class="Voroška.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Гра Ворожка" Height="400" Width="600">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFF300FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="Gabriola"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF73006C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF73006C" Offset="0"/>
                <GradientStop Color="Black" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Задайте Ваше питання:" 
                       HorizontalAlignment="Center"
                       FontSize="36"
                       Foreground="White"
                       FontFamily="Monotype Corsiva"
                       TextAlignment="Center"/>

            <TextBox x:Name="QuestionTextBox"
                     Width="400"
                     Height="30"
                     FontSize="16"
                     HorizontalAlignment="Center"
                     Margin="10"
                     TextChanged="QuestionTextBox_TextChanged"/>

            <Button x:Name="AnswerButton"
                    Content="Отримати відповідь"
                    Click="AnswerButton_Click"/>

            <TextBlock x:Name="AnswerTextBlock"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FFEFA4F9"
                       Margin="10"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
