<Window x:Class="Lab_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Довідник студентів"
        Height="600" Width="800"
        MinWidth="300" MinHeight="300">
    <Window.Resources>
        <!-- Стиль для центрованого тексту в клітинках DataGrid -->
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стилізація кнопок -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Стилізація Label -->
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стилізація TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <!-- Стилізація DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl x:Name="MainTabControl">

            <!-- Вкладка: Студенти -->
            <TabItem Header="Студенти">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Панель з кнопкою "Оновити" -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right">
                        <Button Content="Оновити" Click="btnRefreshStudents_Click"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="dgStudents"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер залікової книги"
                                    Binding="{Binding Номер_залікової_книги}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                                <DataGridTextColumn Header="Адреса"
                                    Binding="{Binding Адреса}"/>
                                <DataGridTextColumn Header="Код групи"
                                    Binding="{Binding Код_групи}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Вкладка: Група -->
            <TabItem Header="Група">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right">
                        <Button Content="Оновити" Click="btnRefreshGroup_Click"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="dgGroup"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код групи"
                                    Binding="{Binding Код_групи}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                                <DataGridTextColumn Header="Назва групи"
                                    Binding="{Binding Група1}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Запит: Студенти за номером залікової книги -->
            <TabItem Header="Запит: За номером залікової">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <Label Content="Номер залікової:"/>
                        <TextBox x:Name="txtGradebookNumber" Width="150"/>
                        <Button Content="Пошук" Click="btnSearchByGradebook_Click"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="dgQueryGradebook"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер залікової книги"
                                    Binding="{Binding Номер_залікової_книги}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                                <DataGridTextColumn Header="Адреса"
                                    Binding="{Binding Адреса}"/>
                                <DataGridTextColumn Header="Група"
                                    Binding="{Binding Група.Група1}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Запит: Студенти за адресою -->
            <TabItem Header="Запит: За адресою">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <Label Content="Адреса:"/>
                        <TextBox x:Name="txtAddress" Width="200" TextChanged="txtAddress_TextChanged"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="dgQueryAddress"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер залікової книги"
                                    Binding="{Binding Номер_залікової_книги}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                                <DataGridTextColumn Header="Адреса"
                                    Binding="{Binding Адреса}"/>
                                <DataGridTextColumn Header="Група"
                                    Binding="{Binding Група.Група1}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Запит: Студенти за групою (або за кодом, або за назвою) -->
            <TabItem Header="Запит: За групою">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Радіокнопки -->
                        <RowDefinition Height="Auto"/>
                        <!-- Поле вводу і кнопка -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Радіокнопки -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <Label Content="Оберіть тип пошуку:"/>
                        <RadioButton x:Name="rbGroupCode" Content="За кодом" 
                         IsChecked="True"
                         Checked="rbGroupCode_Checked" Margin="10,5"/>
                        <RadioButton x:Name="rbGroupName" Content="За назвою"
                         Checked="rbGroupName_Checked" Margin="10,5"/>
                    </StackPanel>

                    <!-- Поле вводу -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1">
                        <Label x:Name="lblGroupQuery" Content="Код групи:"/>
                        <TextBox x:Name="txtGroupQuery" Width="150"/>
                        <Button Content="Пошук" Click="btnSearchByGroupQuery_Click" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Таблиця результатів -->
                    <ScrollViewer Grid.Row="2"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="dgQueryGroup"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер залікової книги"
                                    Binding="{Binding Номер_залікової_книги}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                                <DataGridTextColumn Header="Адреса"
                                    Binding="{Binding Адреса}"/>
                                <DataGridTextColumn Header="Група"
                                    Binding="{Binding Група.Група1}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Запит: Підрахунок студентів по групах -->
            <TabItem Header="Запит: Кількість студентів">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <Button Content="Підрахувати студентів" Click="btnCountStudents_Click"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="dgQueryCount"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Група"
                                    Binding="{Binding GroupName}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                                <DataGridTextColumn Header="Кількість студентів"
                                    Binding="{Binding StudentCount}"
                                    ElementStyle="{StaticResource CenteredCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
