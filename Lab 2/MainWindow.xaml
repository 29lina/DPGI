<Window x:Class="Lab_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_2"
        mc:Ignorable="d"
        Title="StackPanel_Task" Height="330" Width="500">
    <StackPanel Margin="50">
        <Label HorizontalAlignment="Center">Label</Label>

        <TextBox Text="TextBox" BorderThickness="0,2,0,1"/>
        <TextBox Text="TextBox" BorderThickness="0,1,0,1"/>
        <TextBox Text="TextBox" BorderThickness="0,1,0,1"/>
        <TextBox Text="TextBox" BorderThickness="0,1,0,1"/>

        <Button Margin="55" Width="200">Button</Button>
    </StackPanel>

</Window>