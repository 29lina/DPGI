<Page x:Class="WpfApplProject.PageHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:command="clr-namespace:WpfApplProject.Commands"
      Title="Історія"
      JournalEntry.KeepAlive="False"
      Focusable="True"
      Loaded="Page_Loaded">

    <!-- Прив’язки гарячих клавіш -->
    <Page.InputBindings>
        <KeyBinding Command="command:DataCommands.Undo"    Gesture="Ctrl+Z"
                CommandTarget="{Binding RelativeSource={RelativeSource Self}}"/>
        <KeyBinding Command="command:DataCommands.New"     Gesture="Ctrl+N"
                CommandTarget="{Binding RelativeSource={RelativeSource Self}}"/>
        <KeyBinding Command="command:DataCommands.Replace" Gesture="Ctrl+R"
                CommandTarget="{Binding RelativeSource={RelativeSource Self}}"/>
        <KeyBinding Command="command:DataCommands.Save"    Gesture="Ctrl+S"
                CommandTarget="{Binding RelativeSource={RelativeSource Self}}"/>
        <KeyBinding Command="command:DataCommands.Find"    Gesture="Ctrl+F"
                CommandTarget="{Binding RelativeSource={RelativeSource Self}}"/>
        <KeyBinding Command="command:DataCommands.Delete"  Gesture="Ctrl+D"
                CommandTarget="{Binding RelativeSource={RelativeSource Self}}"/>
    </Page.InputBindings>

    <Page.Resources>
        <!-- Центрування -->
        <Style x:Key="CenterCellStyle"    TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>
        <Style x:Key="CenterHeaderStyle"  TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenterTextStyle"    TargetType="TextBlock">
            <Setter Property="TextAlignment"     Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Page.CommandBindings>
        <CommandBinding Command="command:DataCommands.Undo"    CanExecute="Undo_CanExecute"    Executed="Undo_Executed"/>
        <CommandBinding Command="command:DataCommands.New"     CanExecute="New_CanExecute"     Executed="New_Executed"/>
        <CommandBinding Command="command:DataCommands.Replace" CanExecute="Replace_CanExecute" Executed="Replace_Executed"/>
        <CommandBinding Command="command:DataCommands.Save"    CanExecute="Save_CanExecute"    Executed="Save_Executed"/>
        <CommandBinding Command="command:DataCommands.Find"    CanExecute="Find_CanExecute"    Executed="Find_Executed"/>
        <CommandBinding Command="command:DataCommands.Delete"  CanExecute="Delete_CanExecute"  Executed="Delete_Executed"/>
    </Page.CommandBindings>

    <DockPanel Background="White" LastChildFill="True" Margin="10">
        <!-- Меню та тулбар -->
        <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
            <Menu HorizontalAlignment="Center" Margin="0,0,0,5">
                <MenuItem Header="Дія">
                    <MenuItem Header="Скасувати" Command="command:DataCommands.Undo"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <MenuItem Header="Створити"   Command="command:DataCommands.New"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <MenuItem Header="Редагувати"  Command="command:DataCommands.Replace"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <Separator/>
                    <MenuItem Header="Зберегти"   Command="command:DataCommands.Save"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <Separator/>
                    <MenuItem Header="Пошук"      Command="command:DataCommands.Find"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <MenuItem Header="Видалити"   Command="command:DataCommands.Delete"
                    CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}"/>
                </MenuItem>
                <MenuItem Header="Звіт">
                    <MenuItem Header="Експорт в Excel" Click="ReportExcel_Click"/>
                    <MenuItem Header="Експорт в Word"  Click="ReportWord_Click"/>
                </MenuItem>
            </Menu>
            <ToolBar HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Command="command:DataCommands.Undo"
                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}" ToolTip="Скасувати">
                    <Image Source="Images/undo.png" Width="16" Height="16"/>
                </Button>
                <Button Command="command:DataCommands.New"
                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}" ToolTip="Створити">
                    <Image Source="Images/new.png" Width="16" Height="16"/>
                </Button>
                <Button Command="command:DataCommands.Replace"
                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}" ToolTip="Редагувати">
                    <Image Source="Images/replace.png" Width="16" Height="16"/>
                </Button>
                <Button Command="command:DataCommands.Save"
                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}" ToolTip="Зберегти">
                    <Image Source="Images/save.png" Width="16" Height="16"/>
                </Button>
                <Button Command="command:DataCommands.Find"
                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}" ToolTip="Пошук">
                    <Image Source="Images/find.png" Width="16" Height="16"/>
                </Button>
                <Button Command="command:DataCommands.Delete"
                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}" ToolTip="Видалити">
                    <Image Source="Images/delete.png" Width="16" Height="16"/>
                </Button>
            </ToolBar>
        </StackPanel>

        <!-- Панель дій (над табличкою) -->
        <StackPanel Name="ActionPanel"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Margin="0,0,0,10"
                HorizontalAlignment="Center">

            <!-- NEW / EDIT -->
            <StackPanel Name="EditPanel"
                  Orientation="Horizontal"
                  Visibility="Collapsed"
                  Margin="0,0,0,5">
                <TextBox Name="ExampleTextBox" Width="300" Margin="0,0,5,0"/>
            </StackPanel>

            <!-- FIND -->
            <StackPanel Name="FindPanel"
                  Orientation="Vertical"
                  Visibility="Collapsed"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <RadioButton Content="Дата"     Name="DateRadio"    Checked="DateRadio_Checked"    Margin="0,0,5,0"/>
                    <RadioButton Content="Приклад"  Name="ExampleRadio" Checked="ExampleRadio_Checked" Margin="0,0,5,0"/>
                    <RadioButton Content="Результат" Name="ResultRadio"  Checked="ResultRadio_Checked"/>
                </StackPanel>

                <!-- Пошук по даті -->
                <StackPanel Name="DateSearchPanel"
                    Orientation="Horizontal"
                    Visibility="Collapsed"
                    Margin="0,0,0,5">
                    <TextBox Name="DayText"    Width="30"  MaxLength="2" TextChanged="SearchFields_TextChanged" ToolTip="День"/>
                    <TextBox Name="MonthText"  Width="30"  MaxLength="2" TextChanged="SearchFields_TextChanged" ToolTip="Місяць"/>
                    <TextBox Name="YearText"   Width="50"  MaxLength="4" TextChanged="SearchFields_TextChanged" ToolTip="Рік"/>
                    <TextBox Name="HourText"   Width="30"  MaxLength="2" TextChanged="SearchFields_TextChanged" ToolTip="Година"/>
                    <TextBox Name="MinuteText" Width="30"  MaxLength="2" TextChanged="SearchFields_TextChanged" ToolTip="Хвилина"/>
                </StackPanel>

                <!-- Пошук по тексту -->
                <TextBox Name="ExampleSearchText" Width="300" Visibility="Collapsed" 
                 TextChanged="SearchFields_TextChanged" ToolTip="Шукати 'Приклад'"/>
                <TextBox Name="ResultSearchText"  Width="300" Visibility="Collapsed"
                 TextChanged="SearchFields_TextChanged" ToolTip="Шукати 'Результат'"/>
            </StackPanel>

            <!-- DELETE -->
            <StackPanel Name="DeletePanel"
                  Orientation="Horizontal"
                  Visibility="Collapsed"
                  HorizontalAlignment="Center">
                <Button Content="Очистити все" Click="ClearAll_Click" Margin="0,0,10,0"/>
                <Button Content="Видалити запис"
                Command="command:DataCommands.Save"
                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Page}}"/>
            </StackPanel>
        </StackPanel>

        <!-- DataGrid з межами та центрацією -->
        <DataGrid Name="HistoryDataGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              CanUserAddRows="False"
              GridLinesVisibility="All"
              SelectionChanged="HistoryDataGrid_SelectionChanged"
              MouseDoubleClick="HistoryDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"        Binding="{Binding Id}"        Width="Auto"
                            CellStyle="{StaticResource CenterCellStyle}"
                            ElementStyle="{StaticResource CenterTextStyle}"
                            HeaderStyle="{StaticResource CenterHeaderStyle}"/>
                <DataGridTextColumn Header="Приклад"   Binding="{Binding Приклад}"   Width="*"
                            CellStyle="{StaticResource CenterCellStyle}"
                            ElementStyle="{StaticResource CenterTextStyle}"
                            HeaderStyle="{StaticResource CenterHeaderStyle}"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Результат}" Width="Auto"
                            CellStyle="{StaticResource CenterCellStyle}"
                            ElementStyle="{StaticResource CenterTextStyle}"
                            HeaderStyle="{StaticResource CenterHeaderStyle}"/>
                <DataGridTextColumn Header="Дата"
                            Binding="{Binding Дата, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto"
                            CellStyle="{StaticResource CenterCellStyle}"
                            ElementStyle="{StaticResource CenterTextStyle}"
                            HeaderStyle="{StaticResource CenterHeaderStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>
