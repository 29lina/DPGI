<Page x:Class="WpfApplProject.PageMain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Головна">
    <Page.Resources>
        <LinearGradientBrush x:Key="GradientBackground"
                             StartPoint="0.5,0"
                             EndPoint="0.5,1">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FF921F1F" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Background="{StaticResource GradientBackground}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Калькулятор"
                    Width="200" Height="50"
                    FontSize="18"
                    Margin="0,0,0,20"
                    Click="Calculator_Click"/>
            <Button Content="Історія"
                    Width="200" Height="50"
                    FontSize="18"
                    Margin="0,0,0,20"
                    Click="History_Click"/>
        </StackPanel>
    </Grid>
</Page>
