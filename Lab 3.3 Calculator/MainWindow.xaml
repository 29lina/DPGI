<Window x:Class="CalculatorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор"
        Height="450"
        Width="350"
        Background="#FF580303">

    <Window.Resources>
        <Style TargetType="Button" x:Key="CalcButtonStyle">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="DarkGray"/>
        </Style>

        <Style TargetType="TextBox" x:Key="DisplayTextBoxStyle">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Gray"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="Black" Offset="0"/>
                <GradientStop Color="#FFB42525" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="Display"
                 Style="{StaticResource DisplayTextBoxStyle}"
                 Grid.Row="0"
                 Height="50"
                 Text="0" />

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="C"
                    Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Clear_Click"/>
            <Button Content="±"
                    Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Negate_Click"/>
            <Button Content="%"
                    Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Percent_Click"/>
            <Button Content="÷"
                    Grid.Row="0" Grid.Column="3"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Operator_Click"/>

            <Button Content="7"
                    Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="8"
                    Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="9"
                    Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="×"
                    Grid.Row="1" Grid.Column="3"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Operator_Click"/>

            <Button Content="4"
                    Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="5"
                    Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="6"
                    Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="−"
                    Grid.Row="2" Grid.Column="3"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Operator_Click"/>

            <Button Content="1"
                    Grid.Row="3" Grid.Column="0"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="2"
                    Grid.Row="3" Grid.Column="1"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="3"
                    Grid.Row="3" Grid.Column="2"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="+"
                    Grid.Row="3" Grid.Column="3"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Operator_Click"/>

            <Button Content="0"
                    Grid.Row="4" Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Number_Click"/>
            <Button Content="."
                    Grid.Row="4" Grid.Column="2"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Decimal_Click"/>
            <Button Content="="
                    Grid.Row="4" Grid.Column="3"
                    Style="{StaticResource CalcButtonStyle}"
                    Click="Equals_Click"/>
        </Grid>
    </Grid>
</Window>
